{
  "name": "@asm/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "asm": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/index.js', 0o755)\"",
    "bundle": "node scripts/bundle.mjs",
    "dev": "tsx --conditions=development src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@asm/shared": "workspace:*",
    "commander": "^15.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "tsx": "^4.23.15"
  },
  "files": [
    "dist"
  ]
}
